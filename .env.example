# Local startup requires no environment file or keys.
TURSO_DATABASE_URL=file:./data/deal-radar.db
# Hosted Turso: use libsql://... and set its token; migrate explicitly.
# TURSO_AUTH_TOKEN=
# Hosted sessions require a random secret of at least 32 characters.
# SESSION_SECRET=
# Exact external origin, no path or trailing slash. Required HTTPS on Vercel.
# APP_ORIGIN=https://your-project.vercel.app
# Local reverse proxy example: APP_ORIGIN=http://localhost:3000
# Optional grounded reason ordering/wording; normal flows need no AI key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
