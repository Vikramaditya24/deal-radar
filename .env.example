# No environment file is required for local startup.
# For hosted Turso, supply both values and run npm run db:migrate explicitly.
TURSO_DATABASE_URL=file:./data/deal-radar.db
# TURSO_AUTH_TOKEN=
# Production requires a strong secret (minimum 32 characters).
# SESSION_SECRET=
# APP_ORIGIN=http://localhost:3000
# Optional reasoning is implemented in Phase 4.
# OPENAI_API_KEY=
# OPENAI_MODEL=
